# Config Supabase — à renseigner dans Vercel (Settings > Environment Variables)
# et en local dans .env.local (NON versionné).
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# (Optionnel) Cle API ISBNdb — variable SERVEUR Vercel uniquement (jamais prefixe VITE_).
# Laisse vide si tu n'as pas de cle : la source ISBNdb est alors ignoree.
ISBNDB_API_KEY=
